type (
	EsQueryReq {
		query      string `json:"query"`
		traceError bool   `json:"traceError,optional"`
	}
	EsQueryRsp {
		profile     EsQueryProfile   `json:"profile"`
		queryErrors []string         `json:"queryErrors"`
		evalErrors  []string         `json:"evalErrors"`
		columnNames []string         `json:"columnNames"`
		data        []EsQueryRspData `json:"data"`
	}
	EsQueryProfile {
		fetchCount  int `json:"fetchCount"`
		resultCount int `json:"resultCount"`
		fetchTime   int `json:"fetchTime"`
		evalTime    int `json:"evalTime"`
	}
	EsQueryRspData {
		timestamp int      `json:"timestamp"`
		value     []string `json:"value"`
	}
	EsExportReq {
		query      string `json:"query"`
		traceError bool   `json:"traceError,optional"`
	}
	EsExportRsp {
		queryErrors []string `json:"queryErrors"`
		taskId      string   `json:"taskId"`
	}
	EsTaskStatusReq {
		taskId string `json:"taskId"`
	}
	EsTaskStatusRsp {
		state   string `json:"state"`
		process int    `json:"process"`
		total   int    `json:"total"`
		done    bool   `json:"done"`
		link    string `json:"link"`
	}
)

@server (
	prefix:  /api/v1/es
	group:   es
	timeout: 100s
)
service api-api {
	@handler QueryHandler
	post /query (EsQueryReq) returns (EsQueryRsp)

	@handler ExportHandler
	post /export (EsExportReq) returns (EsExportRsp)

	@handler TaskStatusHandler
	post /taskstatus (EsTaskStatusReq) returns (EsTaskStatusRsp)
}

type (
	AdminStatusReq  {}
	AdminStatusRsp  {}
)

@server (
	prefix: /api/v1/admin
	group:  admin
)
service api-api {
	@handler StatusHandler
	post /status (AdminStatusReq) returns (AdminStatusRsp)
}

