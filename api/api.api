syntax = "v1"

import "wstype.api"

type NodesReq {}

type NodeInfo {
	nodeId     string   `json:"nodeId"`
	name       string   `json:"name"`
	os         string   `json:"os"`
	arch       string   `json:"arch"`
	macs       []string `json:"macs"`
	ips        []string `json:"ips"`
	lastSeenAt string   `json:"lastSeenAt"`
	cpu        string   `json:"cpu"`
	memory     string   `json:"memory"`
	disk       string   `json:"disk"`
	upTime     string   `json:"upTime"`
	latency    int      `json:"latency"`
	status     string   `json:"status"`
}

type NodesRsp {
	nodes []NodeInfo `json:"nodes"`
}

type SetAliasReq {
	id    string `path:"id"`
	alias string `json:"alias"`
}

type GetDataKeysReq {
	id string `path:"id"`
}

type Provider {
	ptype string   `json:"type"`
	args  []string `json:"args"`
	str   string   `json:"str,optional"`
}

type ProviderKey {
	provider Provider `json:"provider"`
	key      string   `json:"key"`
}

type ProviderKeys {
	provider Provider `json:"provider"`
	keys     []string `json:"keys"`
}

type GetDataKeysRsp {
	keys []ProviderKeys `json:"keys"`
}

type SetAliasRsp {
	ok bool `json:"ok"`
}

type LogToMetricQuery {
	LogQuery LogQuery `json:"logQuery"`
	Keys     []string `json:"keys"`
}

type LogQuery {
	NodeId   string   `json:"nodeId"`
	Provider Provider `json:"provider"`
}

type SetListenReq {
	SessionId  string     `json:"sessionId"`
	LogQueries []LogQuery `json:"logQueries"`
}

@server (
	prefix: /api/v1
)
service api-api {
	@handler NodesHandler
	post /nodes (NodesReq) returns (NodesRsp)

	@handler SetAliasHandler
	post /node/:id/alias (SetAliasReq) returns (SetAliasRsp)

	@handler GetDataKeysHandler
	post /node/:id/data/keys (GetDataKeysReq) returns (GetDataKeysRsp)

	@handler SetListenHandler
	post /listen (SetListenReq)

	@handler WsListenHandler
	get /ws/listen
}

type (
	TypeListReq {
		cid string `json:"cid"`
	}
	TypeListRsp {
		messages []string `json:"messages"`
		services []string `json:"services"`
	}
	TypeGenReq {
		cid string `json:"cid"`
	}
	TypeGenRsp {
		pb map[string]string `json:"pb"`
	}
	AgentListReq  {}
	AgentListRsp {
		agents map[string]string `json:"agents"`
	}
	LinkListenReq {
		cid string `path:"cid"`
	}
)

type (
	CallbackItem {
		url     string            `json:"url"`
		method  string            `json:"method"`
		headers map[string]string `json:"headers"`
		enabled bool              `json:"enabled"`
	}
	DataCallbackItem {
		id           string            `json:"id"`
		url          string            `json:"url"`
		method       string            `json:"method"`
		headers      map[string]string `json:"headers"`
		enabled      bool              `json:"enabled"`
		topicPattern string            `json:"topicPattern"`
	}
	BasicCallbackConfig {
		online  CallbackItem `json:"online"`
		offline CallbackItem `json:"offline"`
	}
	CallbackConfig {
		basic BasicCallbackConfig `json:"basic"`
		data  []DataCallbackItem  `json:"data"`
	}
	GetCallbackReq {
		cid string `json:"cid"`
	}
	SetCallbackReq {
		cid    string         `json:"cid"`
		config CallbackConfig `json:"config"`
	}
)

@server (
	prefix:  /api/v1/link
	group:   link
	timeout: 5s
)
service api-api {
	@handler TypeListHandler
	post /type/list (TypeListReq) returns (TypeListRsp)

	@handler TypeGenHandler
	post /type/gen (TypeGenReq) returns (TypeGenRsp)

	@handler AgentListHandler
	post /agent/list (AgentListReq) returns (AgentListRsp)

	@handler LinkListenHandler
	get /listen/:cid (LinkListenReq)

	@handler GetCallbackHandler
	post /get/callback (GetCallbackReq) returns (CallbackConfig)

	@handler SetCallbackHandler
	post /set/callback (SetCallbackReq) returns (CallbackConfig)
}

