syntax = "v1"

import "wstype.api"

type NodesReq {}

type NodeInfo {
	id         string   `json:"id"`
	alias      string   `json:"alias"`
	macs       []string `json:"macs"`
	ips        []string `json:"ips"`
	lastSeenAt string   `json:"lastSeenAt"`
}

type NodesRsp {
	nodes []NodeInfo `json:"nodes"`
}

type SetAliasReq {
	id    string `path:"id"`
	alias string `json:"alias"`
}

type GetDataKeysReq {
	id string `path:"id"`
}

type Provider {
	ptype string   `json:"type"`
	args  []string `json:"args"`
	str   string   `json:"str,optional"`
}

type ProviderKey {
	provider Provider `json:"provider"`
	key      string   `json:"key"`
}

type ProviderKeys {
	provider Provider `json:"provider"`
	keys     []string `json:"keys"`
}

type GetDataKeysRsp {
	keys []ProviderKeys `json:"keys"`
}

type SetAliasRsp {
	ok bool `json:"ok"`
}

type LogToMetricQuery {
	LogQuery LogQuery `json:"logQuery"`
	Keys     []string `json:"keys"`
}

type LogQuery {
	NodeId   string   `json:"nodeId"`
	Provider Provider `json:"provider"`
}

type SetListenReq {
	SessionId  string     `json:"sessionId"`
	LogQueries []LogQuery `json:"logQueries"`
}

@server (
	prefix: /api/v1
)
service api-api {
	@handler NodesHandler
	post /nodes (NodesReq) returns (NodesRsp)

	@handler SetAliasHandler
	post /node/:id/alias (SetAliasReq) returns (SetAliasRsp)

	@handler GetDataKeysHandler
	post /node/:id/data/keys (GetDataKeysReq) returns (GetDataKeysRsp)

	@handler SetListenHandler
	post /listen (SetListenReq)

	@handler WsListenHandler
	get /ws/listen
}

