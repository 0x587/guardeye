syntax = "v1"

import "wstype.api"

type NodesReq {}

type NodeInfo {
	id         string   `json:"id"`
	alias      string   `json:"alias"`
	macs       []string `json:"macs"`
	ips        []string `json:"ips"`
	lastSeenAt string   `json:"lastSeenAt"`
}

type NodesRsp {
	nodes []NodeInfo `json:"nodes"`
}

type SetAliasReq {
	id    string `path:"id"`
	alias string `json:"alias"`
}

type GetDataKeysReq {
	id string `path:"id"`
}

type Provider {
	ptype string   `json:"type"`
	args  []string `json:"args"`
	str   string   `json:"str,optional"`
}

type ProviderKey {
	provider Provider `json:"provider"`
	key      string   `json:"key"`
}

type ProviderKeys {
	provider Provider `json:"provider"`
	keys     []string `json:"keys"`
}

type GetDataKeysRsp {
	keys []ProviderKeys `json:"keys"`
}

type SetAliasRsp {
	ok bool `json:"ok"`
}

type LogToMetricQuery {
	LogQuery LogQuery `json:"logQuery"`
	Keys     []string `json:"keys"`
}

type LogQuery {
	NodeId   string   `json:"nodeId"`
	Provider Provider `json:"provider"`
}

type SetListenReq {
	SessionId  string     `json:"sessionId"`
	LogQueries []LogQuery `json:"logQueries"`
}

@server (
	prefix: /api/v1
)
service api-api {
	@handler NodesHandler
	post /nodes (NodesReq) returns (NodesRsp)

	@handler SetAliasHandler
	post /node/:id/alias (SetAliasReq) returns (SetAliasRsp)

	@handler GetDataKeysHandler
	post /node/:id/data/keys (GetDataKeysReq) returns (GetDataKeysRsp)

	@handler SetListenHandler
	post /listen (SetListenReq)

	@handler WsListenHandler
	get /ws/listen
}

type (
	MetricQuery {
		Type      string         `json:"type,options=Number|String"`
		Name      string         `json:"name"`
		ParsePath string         `json:"parsePath"`
		Filters   []MetricFilter `json:"filters"`
	}
	MetricFilter {
		Metric MetricQuery `json:"metric"`
		Op     string      `json:"op,options=EQ|NE"`
		Value  string      `json:"value"`
	}
	MetricQueryGroup {
		NodeId   string        `json:"nodeId"`
		Provider string        `json:"provider"`
		Queries  []MetricQuery `json:"queries"`
	}
	GetQueriesReq {
		NodeId string `json:"nodeId,optional"`
	}
	GetQueriesRsp {
		Queries []MetricQueryGroup `json:"queries"`
	}
	GetMetricDetailReq {
		NodeId string `json:"nodeId"`
		Name   string `json:"name"`
	}
	GetMetricDetailRsp {
		FirstTimestamp int64 `json:"firstTimestamp"`
		LastTimestamp  int64 `json:"lastTimestamp"`
		TotalSamples   int64 `json:"totalSamples"`
	}
	FetchMetricDataReq {
		Metric       GetMetricDetailReq `json:"metric"`
		From         int                `json:"from"`
		To           int                `json:"to"`
		WindowSecond int                `json:"windowSecond,optional"`
		Aggregator   string             `json:"aggregator,optional,options=avg|sum|min|max|range|count"`
	}
	FetchMetricDataRsp {
		Data map[int64]float64 `json:"data"`
	}
)

@server (
	prefix: /api/v1/logtometric
	group:  logtometric
)
service api-api {
	@handler GetQueriesHandler
	post /queryies (GetQueriesReq) returns (GetQueriesRsp)

	@handler GetMetricDetailHandler
	post /metric/detail (GetMetricDetailReq) returns (GetMetricDetailRsp)

	@handler FetchMetricDataHandler
	post /metric/data (FetchMetricDataReq) returns (FetchMetricDataRsp)
}

type (
	EsQueryReq {
		query   string `json:"query"`
		startAt int    `json:"startAt"`
		endAt   int    `json:"endAt"`
	}
	EsQueryRsp  {}
)

@server (
	prefix: /api/v1/es
	group:  es
)
service api-api {
	@handler QueryHandler
	post /query (EsQueryReq) returns (EsQueryRsp)
}

