syntax = "v1"

type WsMsgBase {
    cmd string `json:"cmd"`
}

type WsInitRsp {
    WsMsgBase
    SessionId string `json:"sessionId"`
}

type Metric {
    Name string `json:"name"`
    Value string `json:"value"`
}

type WsMetricRsp {
    WsMsgBase
    Metrics []Metric `json:"metrics"`
}

type WsLogRsp {
    WsMsgBase
    Logs []string `json:"logs"`
}